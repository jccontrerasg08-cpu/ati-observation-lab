{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ati-observation-proxy",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "observability": {
    "enabled": false
  },
  "secrets": {
    "required": [
      "ATI_ALLOWED_CAMPAIGN_IDS",
      "ATI_CLIENT_PSEUDONYM_KEY",
      "ATI_ORIGIN_URL",
      "ATI_PROXY_ORIGIN_TOKEN"
    ]
  }
}
